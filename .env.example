APP_URL=http://localhost:8000

# Cashfree
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=replace_with_your_cashfree_app_id
CASHFREE_SECRET_KEY=replace_with_your_cashfree_secret_key
CASHFREE_API_VERSION=2025-01-01

# Mailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME=EM Karnataka 2026
SMTP_FROM_EMAIL=your_email@example.com
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Registration Admin

# Google Sheets (optional; leave disabled until configured)
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=replace_with_your_spreadsheet_id
GOOGLE_SHEETS_RANGE=Registrations!A:U
GOOGLE_SERVICE_ACCOUNT_FILE=config/google-service-account.json
